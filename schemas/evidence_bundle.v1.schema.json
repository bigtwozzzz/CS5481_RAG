{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs5481:evidence_bundle.v1",
  "title": "evidence_bundle.v1",
  "description": "Selected complete evidence. May be built before any API submission. Source authenticity and retrieval membership require provenance checks.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "evidence_bundle.v1"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "query": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "READY",
        "NO_EVIDENCE",
        "ERROR"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "index": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "excluded_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "chunk_id",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "token_budget": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "profile_version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "method": {
              "const": "official_offline_tokenizer"
            },
            "check_status": {
              "const": "PASS"
            },
            "input_tokens_local": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens_reserved": {
              "type": "integer",
              "minimum": 1
            },
            "safety_margin_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "application_total_token_limit": {
              "type": "integer",
              "minimum": 1
            },
            "total_tokens_reserved": {
              "type": "integer",
              "minimum": 0
            },
            "headroom_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "provider_tokenizer_parity_verified": {
              "const": false
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "profile_version",
            "method",
            "check_status",
            "input_tokens_local",
            "output_tokens_reserved",
            "safety_margin_tokens",
            "application_total_token_limit",
            "total_tokens_reserved",
            "headroom_tokens",
            "provider_tokenizer_parity_verified",
            "payload_sha256"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "source_record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_scope": {
      "const": "selected_for_generation_not_proof_of_api_submission"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "query",
    "status",
    "evidence",
    "index",
    "excluded_evidence",
    "token_budget",
    "source_record_sha256",
    "evidence_scope",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "minItems": 1
          },
          "index": {
            "type": "object"
          },
          "error": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NO_EVIDENCE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "array",
            "maxItems": 0
          },
          "error": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "diagnostics": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true
    },
    "citation": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "published_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "source_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_domain": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "url",
        "title",
        "published_at_utc",
        "source_name",
        "source_domain"
      ],
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "chunk_index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      },
      "required": [
        "source_id",
        "rank",
        "chunk_id",
        "document_id",
        "chunk_index",
        "text",
        "text_sha256",
        "citation"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "chunk_index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "published_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "source_id",
        "rank",
        "chunk_id",
        "document_id",
        "chunk_index",
        "text",
        "text_sha256",
        "citation",
        "url",
        "title",
        "published_at_utc"
      ],
      "additionalProperties": false
    },
    "quote": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[1-9][0-9]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote"
          },
          "minItems": 1
        }
      },
      "required": [
        "text",
        "source_ids",
        "evidence_quotes"
      ],
      "additionalProperties": false
    },
    "located": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$"
        },
        "chunk_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "source_id",
        "chunk_id",
        "quote",
        "char_start",
        "char_end"
      ],
      "additionalProperties": false
    },
    "saved_claim": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[1-9][0-9]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote"
          },
          "minItems": 1
        },
        "claim_id": {
          "type": "string",
          "pattern": "^C[1-9][0-9]*$"
        },
        "located_quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/located"
          },
          "minItems": 1
        }
      },
      "required": [
        "text",
        "source_ids",
        "evidence_quotes",
        "claim_id",
        "located_quotes"
      ],
      "additionalProperties": false
    }
  }
}